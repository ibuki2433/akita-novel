# Copy to .env.local for development. Configure these privately in Render too.
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=
ADMIN_USERNAME=Ibuki
ADMIN_EMAIL=
# At least 12 characters, at most 72 UTF-8 bytes. Only used to create a new admin.
ADMIN_PASSWORD=
# Optional: at least 32 random characters. If empty, a random secret is stored in DB.
JWT_SECRET=
